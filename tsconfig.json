{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "useDefineForClassFields": true
  },
  "include": [
    "App.tsx",
    "main.tsx",
    "types.ts",
    "api.ts",
    "component-*.tsx",
    "vite.config.ts",
    "env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "index.ts",
    "provider-*.ts"
  ]
}
